# Generate a token with: openssl rand -hex 32
USAGE_API_TOKEN=replace-with-at-least-32-random-characters

# Leave empty to auto-discover codex, or set its absolute path.
CODEX_BIN=/home/your-user/.local/npm/bin/codex

# The HTTP service should stay on loopback and be exposed through HTTPS.
USAGE_HOST=127.0.0.1
USAGE_PORT=8787
USAGE_REFRESH_SECONDS=300
CODEX_TIMEOUT_SECONDS=20
CODEX_LIMIT_ID=codex
